# Gmail SMTP Credentials
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Firebase Service Account (From Firebase Console -> Project Settings -> Service accounts)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

# Backblaze B2 Object Storage (S3-compatible)
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=helaservice-storage
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_PUBLIC_URL_PREFIX=https://f004.backblazeb2.com/file/helaservice-storage
