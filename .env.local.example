# API Security Key (Passed via x-helaservice-key header from client)
HELASERVICE_API_KEY=

# Gmail SMTP Credentials
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Firebase Service Account (From Firebase Console -> Project Settings -> Service accounts)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

# Backblaze B2 Object Storage (S3-compatible job media bucket)
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=helaservice-private
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
MEDIA_URL_BASE=https://helaservice.vercel.app

# Backblaze B2 Private Storage (Private KYC and NIC bucket)
B2_PRIVATE_BUCKET=helaservice-nic-private
B2_PRIVATE_KEY_ID=
B2_PRIVATE_KEY=
B2_PRIVATE_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_PRIVATE_REGION=us-west-004

# NotifyLK SMS Gateway
NOTIFYLK_USER_ID=
NOTIFYLK_API_KEY=
NOTIFYLK_SENDER_ID=

# Vercel Cron Secret (Passed via Authorization: Bearer <CRON_SECRET> header)
CRON_SECRET=your_cron_secret_here
