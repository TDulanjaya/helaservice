# Auto detect text files and perform LF normalization on commit
* text=auto

# Ensure source and config files use LF line endings
*.dart text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.properties text eol=lf

# Batch files must use CRLF for Windows cmd.exe
*.bat text eol=crlf
*.cmd text eol=crlf
