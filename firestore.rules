rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/superAdmins/$(request.auth.uid));
    }

    function isStaffAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.status == 'active';
    }

    function isAdmin() {
      return isSuperAdmin() || isStaffAdmin();
    }

    // check if current user is active (not banned and not currently suspended)
    function isUserActive() {
      return isAuthenticated() && (
        isAdmin() ||
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBanned != true &&
          (
            !("suspendedUntil" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.suspendedUntil == null ||
            request.time > get(/databases/$(database)/documents/users/$(request.auth.uid)).data.suspendedUntil
          )
        )
      );
    }

    // super admins collection: client cannot write
    match /superAdmins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // staff admins collection: only super admin can manage
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // service categories: readable by all, managed by admins
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // user profiles: protected against self-unbanning & privilege escalation
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isAdmin() || (
        isOwner(userId) && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'isBanned', 'bannedAt', 'banReason', 'suspendedUntil', 'nicVerified', 'isVerified'
          ])
        )
      );
      allow delete: if isSuperAdmin();
    }

    // technicians public catalog: protected against self-verification
    match /technicians/{techId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(techId) || isAdmin();
      allow update: if isAdmin() || (
        isOwner(techId) && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'isBanned', 'banned', 'bannedAt', 'banReason', 'nicVerified'
          ])
        )
      );
      allow delete: if isSuperAdmin();

      // private kyc & nic details
      match /private/{document=**} {
        allow read, write: if isOwner(techId) || isAdmin();
      }
    }

    // job requests & quotes
    match /jobRequests/{jobId} {
      allow read: if isAuthenticated();
      allow create: if isUserActive();
      allow update: if isUserActive() && (
        resource.data.customerId == request.auth.uid ||
        request.resource.data.customerId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin() || (
        isUserActive() && resource.data.customerId == request.auth.uid
      );

      // quotes subcollection: provider creates, customer who owns request can accept/decline
      match /quotes/{quoteId} {
        allow read: if isAuthenticated();
        allow create: if isUserActive() && (
          quoteId == request.auth.uid ||
          request.resource.data.providerId == request.auth.uid ||
          isAdmin()
        );
        allow update: if isAuthenticated() && (
          quoteId == request.auth.uid ||
          resource.data.providerId == request.auth.uid ||
          get(/databases/$(database)/documents/jobRequests/$(jobId)).data.customerId == request.auth.uid ||
          isAdmin()
        );
        allow delete: if isAuthenticated() && (
          resource.data.providerId == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // bookings: customer or provider or admin
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isUserActive() && (
        request.resource.data.customerId == request.auth.uid ||
        request.resource.data.providerId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isUserActive() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // chat rooms & messages: strictly restricted to room participants and admin
    match /chatRooms/{roomId} {
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.participants ||
        isAdmin()
      );
      allow create: if isUserActive();
      allow update: if isUserActive() && (
        request.auth.uid in resource.data.participants ||
        isAdmin()
      );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participants ||
          isAdmin()
        );
        allow create: if isUserActive() && (
          request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participants ||
          isAdmin()
        );
        allow update, delete: if isAdmin();
      }
    }

    // live location tracking: provider streams, active booking customer reads
    match /liveLocations/{techId} {
      allow read: if isAuthenticated() && (
        techId == request.auth.uid ||
        (resource.data.allowedViewers != null && request.auth.uid in resource.data.allowedViewers) ||
        isAdmin()
      );
      allow create, update: if isOwner(techId);
      allow delete: if isOwner(techId) || isAdmin();
    }

    // reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isUserActive();
      allow update, delete: if isAdmin();
    }

    // complaints
    match /complaints/{complaintId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isUserActive() && (
        request.resource.data.customerId == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // verification queue: technicians submit KYC, admins review
    match /verificationQueue/{item} {
      allow read: if isAdmin() || (
        isAuthenticated() && (
          item == request.auth.uid ||
          (resource != null && resource.data.providerId == request.auth.uid)
        )
      );
      allow create, update: if isAdmin() || (
        isAuthenticated() && (
          item == request.auth.uid ||
          request.resource.data.providerId == request.auth.uid
        )
      );
      allow delete: if isAdmin();
    }

    match /dispatchEvents/{event} {
      allow read, write: if isAdmin();
    }

    match /districtStats/{stat} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // otp verifications: managed only by serverless api admin sdk
    match /otp_verifications/{email} {
      allow read, write: if false;
    }
  }
}
