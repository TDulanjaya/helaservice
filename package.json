{
  "name": "helaservice-backend",
  "version": "1.0.0",
  "description": "Vercel Serverless OTP API for HelaService",
  "main": "api/send-otp.js",
  "scripts": {
    "start": "vercel dev",
    "test:rules": "firebase emulators:exec --only firestore \"npx jest test/firestore_rules\"",
    "reset:dry": "node scripts/reset-data.js",
    "reset:confirm": "node scripts/reset-data.js --confirm",
    "seed:categories": "node scripts/seed-categories.js",
    "seed:categories:confirm": "node scripts/seed-categories.js --confirm",
    "cleanup:jobs": "node scripts/seed-categories.js --cleanup-jobs",
    "cleanup:jobs:confirm": "node scripts/seed-categories.js --cleanup-jobs --confirm"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1148.0",
    "busboy": "^1.6.0",
    "dotenv": "^18.0.6",
    "firebase-admin": "^12.0.0",
    "nodemailer": "^6.9.13"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "jest": "^30.5.2"
  }
}
